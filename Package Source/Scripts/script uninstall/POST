#!/bin/bash
# Remove RtWlanU.kext / RtWlanU1827.kext entries from the ESP config.plist
# Runs from the Uninstaller component scripts directory (after ./MountESP)
if [ -f /Volumes/ESP/EFI/OC/config.plist ]; then
    count=$(/usr/libexec/PlistBuddy -c "Print :Kernel:Add" /Volumes/ESP/EFI/OC/config.plist 2>/dev/null | grep -c "RtWlanU")
    if [ "$count" -gt 0 ]; then
        arrays=$(/usr/libexec/PlistBuddy -c "Print Kernel:Add" /Volumes/ESP/EFI/OC/config.plist 2>/dev/null | grep -ac Dict)
        index=$((arrays - 1))
        while [ $index -ge 0 ]; do
            if [[ $(/usr/libexec/PlistBuddy -c "Print ':Kernel:Add:$index'" /Volumes/ESP/EFI/OC/config.plist 2>/dev/null | grep -ac "RtWlanU") -eq 1 ]]; then
                /usr/libexec/PlistBuddy -c "Delete ':Kernel:Add:$index'" /Volumes/ESP/EFI/OC/config.plist 2>/dev/null
            fi
            index=$((index - 1))
        done
        echo "Removed RtWlanU.kext / RtWlanU1827.kext in /Volumes/ESP/EFI/OC/config.plist"
    else
        echo "No RtWlanU entries found in /Volumes/ESP/EFI/OC/config.plist"
    fi
else
    echo "config.plist not found in /Volumes/ESP/EFI/OC/"
fi
exit 0